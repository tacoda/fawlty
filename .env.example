# Host port mapping. Copy to `.env` and change the numbers to run a second
# checkout of this stack side by side. Container-internal ports never move.
#
#   cp .env.example .env && make up
#
# Compose derives its project name from the directory name, so two checkouts
# already get separate containers and volumes. Only the host ports collide.

DB_PORT=5432
API_PORT=2300
WEB_PORT=5173
