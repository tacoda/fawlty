{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force:*)"
    ]
  }
}
